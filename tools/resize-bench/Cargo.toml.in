# Manifest for the generated resize-bench workspace. run.sh copies this file
# verbatim to <run>/ws/Cargo.toml; it is never built in place and is not part of
# the zenresize package. No [profile] section: the benchmark executable is built
# with Cargo's production release defaults.
[package]
name = "zenresize-resize-bench"
version = "0.0.0"
edition = "2024"
publish = false
autobins = false

[workspace]

[dependencies]
# Baseline and candidate: verified git-archive exports staged by run.sh, with
# only their [package] version suffixed so both fit one lockfile. Default
# features only, exactly as a production consumer builds them.
zr_old = { package = "zenresize", path = "../src/old" }
zr_new = { package = "zenresize", path = "../src/new" }
# The harness: zenbench at run.sh's ZR_ZENBENCH_COMMIT, staged by run.sh from a
# verified git archive. Its version field equals the crates.io release it
# replaces; prepare proves the lock differs from that release's resolution only
# in zenbench's source and checksum. One executable holds every arm, so every
# arm runs this same harness.
zenbench = { path = "../src/zenbench", version = "=0.1.11", default-features = false, features = ["precise-timing"] }
# Only for the CPU dispatch readback (main.rs `cpu_dispatch`): the version and
# the one feature (`std`) zenresize's production graph already resolves, so the
# feature union is unchanged; prepare's graph check proves it.
archmage = { version = "=0.9.26", default-features = false, features = ["std"] }
serde_json = "1.0.151"
sha2 = "0.11.0"

[[bin]]
name = "resize-bench"
path = "../tool/tools/resize-bench/src/main.rs"
